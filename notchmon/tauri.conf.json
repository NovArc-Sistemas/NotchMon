{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotchMon",
  "version": "1.0.0",
  "identifier": "com.novarc.notchmon",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "consumo",
        "title": "NotchMon",
        "url": "consumo.html",
        "width": 400,
        "height": 700,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "pet",
        "title": "NotchMon Pet",
        "url": "pet.html",
        "width": 220,
        "height": 192,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "NotchMon Settings",
        "url": "settings.html",
        "width": 520,
        "height": 620,
        "minWidth": 460,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
